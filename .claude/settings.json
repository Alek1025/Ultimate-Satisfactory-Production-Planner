{
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm run typecheck)",
      "Bash(npm run build:app)",
      "Bash(npm run summary *)",
      "Bash(npm run plan *)",
      "Bash(npm run facts *)",
      "Bash(npx vitest *)",
      "Bash(npx tsc *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "PowerShell(npm test)",
      "PowerShell(npm test *)",
      "PowerShell(npm run typecheck)",
      "PowerShell(npm run build:app)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "Bash(npm run lint)",
      "Bash(npm run lint *)",
      "PowerShell(npm run lint)",
      "PowerShell(npm run lint *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-edited-file.mjs\"",
            "timeout": 60,
            "statusMessage": "Linting edited file"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/typecheck-before-stop.mjs\"",
            "timeout": 120,
            "statusMessage": "Typechecking changes"
          }
        ]
      }
    ]
  }
}
