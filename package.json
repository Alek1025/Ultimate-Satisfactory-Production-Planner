{
  "name": "satisfactory-planner",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Ultimate Satisfactory Production Planner — save/game-data parsing, LP solver and plan storage (Update 1.2)",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.app.json",
    "test": "vitest run",
    "summary": "tsx scripts/summarize.ts",
    "plan": "tsx scripts/plan.ts",
    "facts": "tsx scripts/problem-facts.ts",
    "dev": "vite",
    "build:app": "tsc -p tsconfig.app.json && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.1.0",
    "@fontsource/barlow-condensed": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.1",
    "elkjs": "^0.10.0",
    "fflate": "^0.8.2",
    "highs": "^1.15.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.6",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
